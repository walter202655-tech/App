# Configuración local de Aura100. Nunca guardes secretos en Git.
NODE_ENV=development
PORT=3000
PUBLIC_DIR=.

# La IA queda desactivada hasta que agregues una clave válida.
OPENAI_API_KEY=replace_with_your_private_api_key
# Opcional. Si se omite, el backend usa el modelo predeterminado definido en src/ai-service.mjs.
OPENAI_MODEL=gpt-6.1-sol

# Opcionales: límites de solicitudes. Estos son también los valores predeterminados.
AI_RATE_LIMIT_WINDOW_MS=600000
AI_RATE_LIMIT_MAX=20

# Solo para producción/beta privada. En Railway configura estos valores en Variables,
# no cambies NODE_ENV a development para evitar la autenticación.
# NODE_ENV=production
# APP_ACCESS_USER=replace_with_a_private_username
# APP_ACCESS_PASSWORD=replace_with_a_random_password_of_at_least_16_characters
# TRUST_PROXY=true
